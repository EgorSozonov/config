vim9script
#{{{ core settings

:set foldmethod=marker
:set tabstop=3
:set softtabstop=0
:set smarttab
:set expandtab
:set smartindent
:set ignorecase
#:set clipboard="unnamed"
:set shiftwidth=3
:set wrap
:set linebreak
g:mapleader = ","
:set nu
:set rnu
# allow having inactive buffers in the same window as the active
:set hidden
:hi LineNr guibg=#000000 guifg=#ffffff
:hi Search ctermbg=8
:hi Normal ctermbg=0
:hi NormalFloat ctermbg=0
:hi Folded ctermbg=8 ctermfg=15

#}}}
#{{{core keybindings

inoremap <silent> <Tab> <Esc>
inoremap <silent> <C-space> <space><space><space>

inoremap <silent> <C-w> <Esc>:wa<CR>
nnoremap <silent> <C-w> <Esc>:wa<CR>

# space in normal mode
nnoremap <silent> <space> i<space><Esc> 
# buffers (next, previous, previous visited)
nnoremap <silent> <C-n> :bn<CR>
nnoremap <silent> <C-p> :bp<CR>
nnoremap <silent> <C-3> :b#<CR>

nnoremap <silent> L 21l
nnoremap <silent> H 21h
nnoremap <silent> x "_x

nnoremap <silent> O O<Esc>
nnoremap <silent> o o<Esc>

# copy and paste
vnoremap <silent> y "+y
nnoremap <silent> Y "+Y
vnoremap <silent> <C-c> "+y
nnoremap <silent> <C-v> "+p
inoremap <silent> <C-v> "+p


#}}}
#{{{ utils

def GetCurrLineNum(): number
   return line(".") - 1
enddef

def GetVisualLineInterval(): tuple<number, number>
   var vstart = getpos("'<")
   var vend = getpos("'>")
   return (vstart[1] - 1, vend[1])
enddef


def GetCurrLine(): string
   return getline(".")
enddef

def GetLine(i: number): string
   return getline(i + 1)
enddef

def SetLine(i: number, newVal: string)
   call setline(i + 1, newVal)
enddef

def GetCountLines(): number
   return line('$')
enddef

def InsertLineAfter(afterInd: number, newLineContent: string)
   call append(afterInd + 1, newLineContent)
enddef


#}}}
#{{{custom functions

def g:CommentOrUncomment()
   var visualLineInt = GetVisualLineInterval()
   var msg = "line " .. visualLineInt[0] .. " to " .. visualLineInt[1]
   var i = visualLineInt[0]
   while i < visualLineInt[1]
      var line = GetLine(i)
      SetLine(i, "//~" .. line)
      i = i + 1
   endwhile
   
enddef


vnoremap <silent> <C-e> :<C-u>call CommentOrUncomment()<CR>

#}}}
