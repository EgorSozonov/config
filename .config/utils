# Back a file up onto all flash sticks mounted by flasher
function bup() {
   local mountDir="/mnt/flash"
   local today
   printf -v today '%(%Y-%m-%d)T' -1
   
   i=0
   while [ -d "$mountDir$i" ]; do
      local backupDir="$mountDir$i/backup/$today"
      mkdir -p "$backupDir"
      
      echo "Backing up to $backupDir"
      cp $1 "$backupDir"
      ((i++))
   done
}



# replaces text in this dir and subdirs
# Examples:
# replaceText 's/ddd/eee/g' '*.txt'
# replaceText 's/ddd/eee/g'
function replaceText() {
   local nameFilter="${2:-'*.*'}"
   local command="find . -type f -name '${nameFilter}' -exec sed -i '$1' {} +"
   eval "$command"
}

function countLoc() {
   declare -a foundFiles

   # Use find with -print0 and readarray with a null delimiter
   readarray -d '' foundFiles < <(find . -type f -name "*.[hc]" -print0)

   declare -i sumLc=0
   # Loop through each element
   for f in "${foundFiles[@]}"; do
      # Apply a shell command to each item
      lineCount=$(sed -e '\|^\s*//.*$|d' -e '/^\s*\*/d' -e '\|^\s*/\*|d' -e '/^\s*$/d' $f | wc -l)
      sumLc=$sumLc+$((lineCount))
   done
   echo $sumLc 
}

function mkcd() {
   mkdir -p "$1"
   cd "$1"
}

function hist() {
   history | grep -i "$1"
}

function ff() {
   find . -type -f -iname "*$1*" 2>/dev/null
}

function fdi() {
   find . -type d -iname "*$1*" 2>/dev/null
}

function mans() {
   man "$1" | grep -iC 5 "$2"
}

function tre() {
   tree -aC -I '.git|vendor' --dirsfirst "$@" | less -FRNX
}

function trash() {
   mv "$@" ~/.local/share/trash/
   echo "Moved to ~/.local/share/trash/"
}

function listening() {
   lsof -iTCP -sTCP:LISTEN -P -n
}

function spaceHogs() {
   du -hs * | sort -rh | head -10
}

function serve() {
   busybox httpd -f
}

function pkStats() {
   pacman -Qi | awk 'BEGIN {OFS=","} /^Name/{name=$3} /^Installed Size/{print $4$5,name}' \
      | sort -h | awk 'BEGIN {FS=","; OFS=" : "} {print $2, $1}' 
}

# `exciseBlock marker file` outputs the lines between `{``{{marker` and `}}``}` from the file
function exciseBlock() {
   awk "/^{{{$1/{f=1;next} /^}}}\$/{f=0} f" $2
}

# Shared library dependencies of a binary. Use like `libraryDeps $(which nvim)`
function libraryDeps() {
   readelf -d $1 | grep NEEDED
}

