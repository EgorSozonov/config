
function unflash() {
   local mountDir="/mnt/flash"
   
   i=0
   while [ -d "$mountDir$i" ]; do
      local backupDir="$mountDir$i"
      sudo umount -q $backupDir
      ((i++))
   done
}

# mount USB flash sticks into /mnt/flash0, 1, 2 etc
function flash() {
   unflash

   declare -a usbSticks
   
   # get the list of USB stick partitions
   local theCommand="lsblk -lntbo NAME,SIZE,MOUNTPOINT | tr -s ' '"
   readarray -t partitions < <(eval $theCommand)
   
   # filter out unmounted, small partitions starting with "sd" like "sdb1"
   local currPrefix=""
   local currName=""
   local newName="" 
   local isNew="false"
   for partition in "${partitions[@]}"; do
      if (( "${#partition}" == 0 )); then
         continue
      fi
      readarray -d " " -t spl <<< $partition
      if [[ "${spl[0]}" =~ ^sd.* ]] && ((spl[1] < 40000000000)); then
         newName="${spl[0]}"
         local newPrefix="${newName//[0-9]/}"
         if [[ $newPrefix != $currPrefix ]]; then
            if [[ $isNew == "true" ]]; then
               usbSticks+=("/dev/$currName")
            fi
            
            currPrefix=$newPrefix
            currName="${spl[0]}"
            isNew="true"
         elif [[ $isNew == "true" ]]; then
            if (( "${#spl[2]}" <= 1 )); then
               usbSticks+=("/dev/$newName")
            fi
            isNew="false"
         fi
      fi
   done
   if [[ $isNew == "true" ]]; then
      usbSticks+=("/dev/$newName")
   fi
   
   declare -a mountCommands
   local i=0
   for stick in "${usbSticks[@]}"; do
      mountCommands+=("sudo mount -o umask=000 -t vfat --mkdir $stick /mnt/flash$i")
      ((i++))
   done

   # mount the partitions
   for cm in "${mountCommands[@]}"; do
      eval $cm
   done
}


