# Back a file up onto all flash sticks mounted by flasher
function bup() {
   local mountDir="/mnt/flash"
   local today
   printf -v today '%(%Y-%m-%d)T' -1
   
   i=0
   while [ -d "$mountDir$i" ]; do
      local backupDir="$mountDir$i/backup/$today"
      mkdir -p "$backupDir"
      
      echo "Backing up to $backupDir"
      cp $1 "$backupDir"
      ((i++))
   done
}



# replaces text in this dir and subdirs
# Examples:
# replaceText 's/ddd/eee/g' '*.txt'
# replaceText 's/ddd/eee/g'
function replaceText() {
   local nameFilter="${2:-'*.*'}"
   local command="find . -type f -name '${nameFilter}' -exec sed -i '$1' {} +"
   eval "$command"
}

function countLoc() {
   declare -a foundFiles

   # Use find with -print0 and readarray with a null delimiter
   readarray -d '' foundFiles < <(find . -type f -name "*.[ch]" -print0)

   declare -i sumLc=0
   # Loop through each element
   for f in "${foundFiles[@]}"; do
      # Apply a shell command to each item
      lineCount=$(sed -e '\|^\s*//.*$|d' -e '/^\s*\*/d' -e '\|^\s*/\*|d' -e '/^\s*$/d' $f | wc -l)
      sumLc=$sumLc+$((lineCount))
   done
   echo $sumLc 
}

function mkcd() {
   mkdir -p "$1"
   cd "$1"
}

function hist() {
   history | grep -i "$1"
}

function ff() {
   find . -type -f -iname "*$1*" 2>/dev/null
}

function fdi() {
   find . -type d -iname "*$1*" 2>/dev/null
}

function mans() {
   man "$1" | grep -iC 5 "$2"
}

function tre() {
   tree -aC -I '.git|vendor' --dirsfirst "$@" | less -FRNX
}

function trash() {
   mv "$@" ~/.local/share/trash/
   echo "Moved to ~/.local/share/trash/"
}

function listening() {
   lsof -iTCP -sTCP:LISTEN -P -n
}

function spaceHogs() {
   du -hs * | sort -rh | head -10
}

function serve() {
   busybox httpd -f
}

function pkSize() {
   pacman -Qi | awk 'BEGIN {OFS=","} /^Name/{name=$3} /^Installed Size/{print $4$5,name}' \
      | sort -h | awk 'BEGIN {FS=","; OFS=" : "} {print $2, $1}' 
}

# `exciseBlock marker file` outputs the lines between `{``{{marker` and `}}``}` from the file
function exciseBlock() {
   awk "/^{{{$1/{f=1;next} /^}}}\$/{f=0} f" $2
}

# Shared library dependencies of a binary. Use like `libraryDeps $(which nvim)`
function libraryDeps() {
   readelf -d $1 | grep NEEDED
}

function plsEdit() {
  if [ -z "$1" ]; then
     echo "Usage: plsEdit /etc/file"
     exit 1
  fi
  TEMP=$(mktemp)
  doas cp "$1" "$TEMP"
  ${EDITOR:-nvim} "$TEMP"
  doas cp "$TEMP" "$1"
  /usr/bin/rm "$TEMP"
}

function fzfDefaults() {
  builtin printf '%s\n' "--height ${FZF_TMUX_HEIGHT:-40%} --min-height 20+ --bind=ctrl-z:ignore $1"
  command cat "${FZF_DEFAULT_OPTS_FILE-}" 2> /dev/null
  builtin printf '%s\n' "${FZF_DEFAULT_OPTS-} $2"
}

function fzfDeleteHistory() {
  [[ -s $1 ]] || return

  local offsets
  offsets=($(sort -rnu "$1"))
  for offset in "${offsets[@]}"; do
    builtin history -d "$offset"
  done

  if [[ ${#offsets[@]} -gt 0 ]] && shopt -q histappend; then
    builtin history -w
  fi
}

function hi() {
   local output script deletefile
   deletefile=$(mktemp)
   [[ $(HISTTIMEFORMAT='' builtin history 1) =~ [[:digit:]]+ ]] # how many history entries
   script='function P(b) { 
         ++n;
         sub(/^[ *]/, "", b);
         if (!seen[b]++) { 
            printf "%d\t%s%c", '$((BASH_REMATCH + 1))' - n, b, 0 
         } 
      }
      NR==1 {
         b = substr($0, 2); next
      }
      /^\t/ { 
         P(b); b = substr($0, 2); next 
      }
      { b = b RS $0 }
      END {
         if (NR) P(b) 
   }'
    
   output=$(
      set +o pipefail
      builtin fc -lnr -2147483648 2> /dev/null |
        exec awk "$script" |             
        FZF_DEFAULT_OPTS=$(fzfDefaults "" "-n2..,.. --scheme=history \
           --bind=ctrl-r:toggle-sort,alt-r:toggle-raw --wrap-sign '"$'\t'"↳ ' \
           --highlight-line \
           --bind 'shift-delete:execute-silent(cat {+f1} >> \"$deletefile\")+exclude-multi' \
           --multi ${FZF_CTRL_R_OPTS-} --read0") \
           FZF_DEFAULT_OPTS_FILE='' fzf --query "$READLINE_LINE"
   )
   fzfDeleteHistory "$deletefile"
   command /usr/bin/rm -f "$deletefile"
   [[ -n $output ]] || return
   READLINE_LINE=${output#*$'\t'}
   if [[ -z $READLINE_POINT ]]; then
      echo "$READLINE_LINE"
   else
      READLINE_POINT=0x7fffffff
   fi
}

# Go up n directory levels. Example: .. 3
function ..() {
   local arg=${1:-1};
   local dir=""
   while [ $arg -gt 0 ]; do
      dir="../$dir"
      arg=$(($arg - 1));
   done
   cd $dir
}

function newFiles() {
   ls -lt ${1+"$@"} | head -20;
}
