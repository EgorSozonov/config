{
    "layer": "top", // Waybar at top layer
    "bar_id": "bar-0",
    "mode": "dock",
    "ipc": true,
    "position": "left", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "width": 10, // Waybar width
    "spacing": 10, // Gaps between modules (4px)
//    "margin-bottom": 10,
//    "margin-left": 10,
//    "margin-right": 10,
    "margin-top": 0,
    // Choose the order of the modules
    "modules-center": ["sway/workspaces", "group/battery", "sway/language", "battery#bat2", 
       "group/date", "group/time", "tray", "temperature"
    ],

	"group/battery": {
		"orientation": "vertical",
		"modules": [
			"battery",
			"battery#2"
		]
   },
	"group/date": {
		"orientation": "vertical",
		"modules": [
			//"clock", year
			"clock#3",
			"clock#2"
		]
   },
	"group/time": {
		"orientation": "vertical",
		"modules": [
			"clock#4",
			"clock#5"//, "clock#6" for seconds
		]
   },

   // Modules configuration
   "sway/workspaces": {
        "icon-size": 36,
         "disable-scroll": false,
         "all-outputs": true,
         "format": "{icon}", 
         "format-icons": {
             "1": "1",
             "2": "2",
             "3": "3",
             "4": "4",
             "5": "q",
             "6": "w",
             "7": "e",
             "8": "r",
             "9": "a",
             "10": "s",
             "11": "d"
         }
   },
   "sway/language": {
      "format": "{}",
      "format-ru": "RU",
      "format-en": "US"
   }, 
   "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
   },
   "tray": {
        "icon-size": 36,
        "spacing": 10
   },
   "clock": {
        // "timezone": "America/New_York",
      "interval": 60,
      "format": "{:%y}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
   },
   "clock#2": {
      // "timezone": "America/New_York",
      "interval": 60,
      "format": "{:%b}",
           "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },
   "clock#3": {
        // "timezone": "America/New_York",
      "interval": 60,
      "format": "{:%d}",
           "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
   },
   "clock#4": {
      // "timezone": "America/New_York",
      "interval": 60,
      "format": "{:%H}",
           "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
   },
   "clock#5": {
      // "timezone": "America/New_York",
      "interval": 60,
      "format": "{:%M}",
           "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
   },
   "clock#6": {
           // "timezone": "America/New_York",
      "interval": 1,
      "format": "{:%OS}",
           "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
   },
   "temperature": {
         "orientation": "vertical",
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C",
        "format-icons": ["", "", ""]
   },

   "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-plugged": "{capacity}%",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
   },
    "battery#2": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} ",
        "format-charging": "",
        "format-plugged": "",
        "format-alt": "{time} {icon} ",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    }
}
