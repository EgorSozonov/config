source ~/.config/aliases

export PS1="\[\e[0;32m\]\W |>\[\e[m\] "
export EDITOR=nvim

stty -ixon # Disable XON/XOFF crap (terminal freezing)

HISTCONTROL=ignoreboth
# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options

shopt -s histappend
# append to the history file, don't overwrite it

shopt -s globstar # the /**/ pattern to select files from all depths

export DEBUGDIR=~/debug
export EXEDIR=~/exes
export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin"
export CARGO_HOME=~/crust/cargo
export RUSTUP_HOME=~/crust/rustup
export VIMRUNTIME=~/.local/share/nvim/site
setxkbmap -layout us,ru -option 'grp:nocaps,grp:lctrl_toggle'
