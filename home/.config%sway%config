# Read `man 5 sway` for a complete reference.

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot -D ~
# Your preferred application launcher
set $menu pkill wofi || wofi --show drun --allow-images -a --columns 2 --prompt ""

###Output configuration & things specific to a particular computer
include specific

### Idle configuration

exec swayidle -w \
#         timeout 600 'swaylock -f -c 000000' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
#         before-sleep 'swaylock -f -c 000000'

#This will lock your screen after 300 seconds of inactivity, then turn off
#your displays after another 300 seconds, and turn your screens back on when
#resumed. It will also lock your screen before your computer goes to sleep.


input type:keyboard {
   xkb_layout "us,ru"
   xkb_options "ctrl:nocaps,grp:lctrl_toggle"
}

### Key bindings
# Start a terminal
bindsym $mod+z exec $term

# Kill focused window
bindsym $mod+c kill

# Start your launcher
bindsym $mod+x exec $menu

#Drag floating windows by holding down $mod and left mouse button. Resize them with right 
#mouse button + $mod. Despite the name, also works for non-floating windows.
#Change normal to inverse to use left mouse button for resizing and right
#mouse button for dragging.
floating_modifier $mod normal

#Reload the configuration file
bindsym $mod+Ctrl+r reload

#Log out from Sway
bindsym $mod+Shift+o exec swaynag -t warning \
   -m 'Do you really want to exit Sway? This will end your Wayland session.' \
   -B 'Yes, exit sway' 'swaymsg exit'

# Moving around:

# Move your focus around
bindsym $mod+f focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+b focus right
# Or use $mod+[up|down|left|right]

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+f move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+b move right

# Workspaces:
#
#   workspace 1 output eDP-1
#   workspace 6 output HDMI-A-1 eDP-1
set $ws0 "0:1"
set $ws1 "1:2"
set $ws2 "2:3"
set $ws3 "3:4"
set $ws4 "4:5"
set $ws5 "5:q"
set $ws6 "6:w"
set $ws7 "7:e"
set $ws8 "8:r"
set $ws9 "9:a"
set $ws10 "10:s"
set $ws11 "11:d"

# Switch to workspace
bindsym $mod+1 workspace $ws0
bindsym $mod+2 workspace $ws1
bindsym $mod+3 workspace $ws2
bindsym $mod+4 workspace $ws3
bindsym $mod+5 workspace $ws4
bindsym $mod+q workspace $ws5
bindsym $mod+w workspace $ws6
bindsym $mod+e workspace $ws7
bindsym $mod+r workspace $ws8
bindsym $mod+a workspace $ws9
bindsym $mod+s workspace $ws10
bindsym $mod+d workspace $ws11
# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws0
bindsym $mod+Shift+2 move container to workspace $ws1
bindsym $mod+Shift+3 move container to workspace $ws2
bindsym $mod+Shift+4 move container to workspace $ws3
bindsym $mod+Shift+5 move container to workspace $ws4
bindsym $mod+Shift+q move container to workspace $ws5
bindsym $mod+Shift+w move container to workspace $ws6
bindsym $mod+Shift+e move container to workspace $ws7
bindsym $mod+Shift+r move container to workspace $ws8
bindsym $mod+Shift+a move container to workspace $ws9
bindsym $mod+Shift+s move container to workspace $ws10
bindsym $mod+Shift+d move container to workspace $ws11

# Layout stuff:

# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits respectively.
#bindsym $mod+b splith
bindsym $mod+v splitv

#Switch the current container between different layout styles
#bindsym $mod+s layout stacking

# Make the current focus fullscreen
bindsym $mod+Shift+t fullscreen
bindsym $mod+t layout toggle tabbed split

#Make the titlebar in tabbed layout as small as possible 
titlebar_padding 1
titlebar_border_thickness 0
font pango:monospace 1

#Toggle the current focus between tiling and floating mode
bindsym $mod+space floating toggle

# Move focus to the parent container
#bindsym $mod+a focus parent

#Scratchpad: Sway has a "scratchpad", which is a bag of holding for windows.
#You can send windows there and get them back later.
#Move the currently focused window to the scratchpad
bindsym $mod+Shift+y move scratchpad

#Show the next scratchpad window or hide the focused scratchpad window.
#If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+y scratchpad show

#Temporary floating dialogs
for_window [app_id="leDialog"] floating enable, resize set 100ppt 100ppt, move absolute position 32 0, border none, fullscreen enable
for_window [app_id="scratch"] move scratchpad, scratchpad show, fullscreen enable
#default_floating_border none
#for_window [floating] border none

 
# Resizing containers:
 
bindsym $mod+h resize shrink width 40px
bindsym $mod+l resize grow width 40px

# Utilities:
#
bindsym --locked XF86AudioLowerVolume exec amixer set Master 3dB-
bindsym --locked XF86AudioRaiseVolume exec amixer set Master 3dB+
bindsym --locked XF86AudioMute exec "~/.config/sway/toggleSound.sh"
# Special keys to adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
# Special key to take a screenshot with grim
bindsym Print exec grimshot save output ~/pictures/screenshots/scr.png
bindsym Shift+Print exec grimshot copy area

    
bar {
   swaybar_command swaybar
   status_command ~/.config/sway/statusBar.sh;
   colors {
      statusline #00ff00
      focused_workspace #ffff00 #000000 #00ff00
      inactive_workspace #000000 #000000 #00ff00
      active_workspace #000000 #000000 #00ff00
      separator #00ff00
   } 
   height 16
   font Linejoy 14
   strip_workspace_numbers yes
   tray_output *
   tray_padding 2
}

#Time-based status bar refreshing
exec while true; do swaymsg -t send_tick; sleep 60; done

default_border pixel 1
############## %border %background %text %indicator %child_border
client.unfocused #000000 #80ff80 #ffffff #000000 #000000
client.focused #80ff80 #80ff80 #ffffff #80ff80 #80ff80
smart_borders on

focus_follows_mouse no

exec_always wlsunset -S 07:00 -s 19:00 -t 3500 -T 6500

