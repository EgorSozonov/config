// Store a key/value (string) pair
typedef struct {
	int key;
	Text value;
} Kv;

//Max chars in a path name including ZERO, see linux/limits.h
#define MAXPATHL   4096
typedef struct stat FileStat;


// defines for evalVars()
#define VALID_PATH      1
#define VALID_HEAD      2

// Character used as separator in autoload function/variable names.
#define AUTOLOAD_CHAR '#'


#include <signal.h>      //for sigatomic_t

#define private static
#define pub
#define pubWrap(a, b)
#define public

////}
////{dev/debug.sh
#! /usr/bin/bash
gcc --std=c23 -O0 -Wall -Wextra -Wno-maybe-uninitialized -Wimplicit-fallthrough=5 -gdwarf-5 \
   -o %%name ./main.c \
   && cgdb -q -x ~/.config/gdb/breaks %%name #--args %%name test/main.c

////}
////{dev/run.sh
#! /usr/bin/bash
gcc --std=c23 -O2 -Wall -Wextra -Wno-maybe-uninitialized -Wimplicit-fallthrough=5 -gdwarf-5 \
   -o %%name ./main.c \
   && ./%%name

////}
