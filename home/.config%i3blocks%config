# Global properties
align=center
separator=true
separator_block_width=30
markup=pango

[keyboard]
command=~/.config/sway/statusBar.sh 1
interval=once
signal=1

[sound]
command=~/.config/sway/statusBar.sh 2
interval=60
signal=2

[battery]
command=~/.config/sway/statusBar.sh 3
interval=120

# Date and Time
[time]
command=~/.config/sway/statusBar.sh 4
interval=30
color=#ffffff
