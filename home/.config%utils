function lanReceive {
   mkdir -p $HOME/.local/state/rsync
   pkill rsync
   RSYNC_USERNAME=$(whoami) rsync --daemon --config=$HOME/.config/rsync/rsync.conf\
      && echo $(ip -4 a show wlan0 | sed -En 's|^.*\.([0-9]+)/.*$|\1|p')
}

function lanSetIp {
   export LAN_TARGET_IP="192.168.1.$1"
}

#`lanSend directory` to send a dir to ~/incoming/rsync on the target computer over LAN
function lanSend {
   if [[ -z $1 ]]; then
      echo "Input a directory to send via LAN"
      return 1
   fi
   if [[ -z "$LAN_TARGET_IP" ]]; then
      echo "Target IP address is not set. On the receiving computer, run `lanReceive`"
      echo "Then on this machine, run `lanSetIp 12` (replacing 12 with that number)."
      echo "Then repeat this command"
      return 1
   fi
   rsync -ar --port=8730 --progress --ignore-existing -- $1 "$LAN_TARGET_IP::m/"
}


function stick() {
   if [[ -z $1 ]]; then
      declare -a unmounted
      readarray -t unmounted < <(lsblk -J | jq -r '[.blockdevices.[] | select (.rm == true)] 
         | select(.[].children[0].mountpoints | length == 0) | map("/dev/" + .children[0].name).[]')
         
      if (( "${#unmounted}" > 0 )) then
         local um="${unmounted[0]}"
         echo "mounting $um"
         doas /usr/bin/mount -o noatime,sync --mkdir "/dev/$um" /mnt/stick
      fi
   else
      doas /usr/bin/mount -o noatime,sync --mkdir "$1" /mnt/stick
   fi
}
