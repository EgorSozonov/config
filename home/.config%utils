}

function pwhichFiles() {
   pacman -Ql $1 | grep "/$" | awk 'BEGIN { FS=" " } {print $2}'
}

function psize() {
   pacman -Qi | awk 'BEGIN {OFS=","} /^Name/{name=$3} /^Installed Size/{print $4$5,name}' \
      | sort -h | awk 'BEGIN {FS=","; OFS=" : "} {print $2, $1}' 
}

function pall() {
   pacman -Qq \
      | fzf --preview 'pacman -Qil {} | grep -v "/$"' --layout=reverse \
         --bind 'enter:execute(pacman -Qil {} | grep -v "/$" | less)'
}

# `exciseBlock marker file` outputs the lines between `{``{{marker` and `}}``}` from the file
function exciseBlock() {
   awk "/^{{{$1/{f=1;next} /^}}}\$/{f=0} f" $2
}

# Shared library dependencies of a binary. Use like `libraryDeps $(which nvim)`
function libraryDeps() {
   echo "Executable: $1"
   echo ""
   echo "Dynamically linked to library dependencies:"
   readelf -d $1 | grep NEEDED | grep -o --color=never '\[.*\]'
   readelf -h $1 | grep Type
}

function plsEdit() {
  if [ -z "$1" ]; then
     echo "Usage: plsEdit /etc/file"
     return 1
  fi
  TEMP=$(mktemp)
  doas cp "$1" "$TEMP"
  ${EDITOR:-nvim} "$TEMP"
  doas cp "$TEMP" "$1"
  /usr/bin/rm "$TEMP"
}

