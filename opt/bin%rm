#! /usr/bin/bash

undeletable=("/bin" "/boot" "/dev" "/etc" "/home" "/lib" "/lib64" "/mnt" "/opt"
	"/proc" "/root" "/run" "/sbin" "/srv" "/sys" "/tmp" "/usr" "/var" "/"
)

undeletableHome=(".config" ".local" "ystem" "docs")
for arg in "$@"; do
	canDelete=1
	for un in "${undeletable[@]}"; do
		if [[ "$arg" == "$un" || "$arg" == "$un/" ]]; then
			echo "nono! $arg $un"
			canDelete=0
			break
		fi
	done
	for un in "${undeletableHome[@]}"; do
		if [[ $(realpath "$arg") == /home/*/$un ]]; then
			echo "nono! $arg $un"
			canDelete=0
			break
		fi
	done
	if [[ "$canDelete" == "1" ]]; then
		if [[ -d "$arg" ]]; then

			read -p "Are you sure about deleting this directory? (y/no)" -n 1 -r
			echo
			if [[ $REPLY =~ ^[Yy]$ ]] then
				/usr/bin/rm -fr "$arg"
			fi
		elif [[ -f "$arg" ]]; then
			/usr/bin/rm -i "$arg"
		fi
	fi
done

